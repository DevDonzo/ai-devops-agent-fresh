# =============================================================================
# ML DevOps Intelligence Platform - Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Provider Selection
# -----------------------------------------------------------------------------
# LLM Provider: gemini (default), bedrock, azure_openai
LLM_PROVIDER=gemini

# Storage Provider: local (default), s3, azure_blob, synapse
STORAGE_PROVIDER=local

# ML Options
USE_SAGEMAKER=false
USE_LOCAL_CLASSIFIER=true

# -----------------------------------------------------------------------------
# Google Gemini (Default LLM)
# -----------------------------------------------------------------------------
# Get a free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# AWS Configuration (Bedrock, SageMaker, S3)
# -----------------------------------------------------------------------------
# AWS credentials (or use ~/.aws/credentials)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Bedrock
BEDROCK_MODEL=claude-3-sonnet  # Options: claude-3-sonnet, claude-3-haiku, titan-text

# AWS S3 Storage
S3_BUCKET=your-bucket-name
S3_PREFIX=assessments

# AWS SageMaker
# SAGEMAKER_ENDPOINT=risk-classifier-endpoint
# SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789:role/SageMakerRole

# -----------------------------------------------------------------------------
# Azure Configuration (OpenAI, Blob Storage, Synapse)
# -----------------------------------------------------------------------------
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Azure Storage
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=  # Alternative to account URL
AZURE_STORAGE_CONTAINER=assessments

# Azure Synapse
SYNAPSE_SQL_ENDPOINT=your-workspace-ondemand.sql.azuresynapse.net
SYNAPSE_DATABASE=devops_ml

# Azure AD Auth (recommended for production)
AZURE_USE_AD=true

# -----------------------------------------------------------------------------
# Local Development
# -----------------------------------------------------------------------------
LOCAL_STORAGE_PATH=./data/assessments
LOCAL_MODEL_PATH=./ml/model_artifacts/risk_classifier.joblib
